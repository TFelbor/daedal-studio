# ────────────────────────────────────────────────────────────────────────────
# .dockerignore — Excludes files from the Docker build context.
#
# A lean build context speeds up docker build by avoiding unnecessary
# file transfers to the Docker daemon.
# ────────────────────────────────────────────────────────────────────────────

# Git internals
.git
.gitignore
.gitattributes

# Secrets — never send to Docker daemon
.env
pythonsrc/config.py

# macOS metadata
.DS_Store
.AppleDouble
**/.DS_Store

# Python artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Large model weight files — stored in named volumes, NOT baked into images
pythonsrc/models/
*.ckpt
*.safetensors
*.bin
*.pt
*.pth

# Pipeline I/O (these are runtime artifacts, not source)
inputs/
outputs/
pythonsrc/inputs/
pythonsrc/outputs/

# IDE
.vscode/
.idea/
*.swp

# Logs
*.log

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
