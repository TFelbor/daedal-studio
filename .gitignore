# Ignore Python Cache
__pycache__/
*.pyc

# Ignore Virtual Environments
venv/
.venv/
env/

# Ignore Mac System Files
.DS_Store

# CRITICAL: Ignore Large Model Weights (We download these on setup)
pythonsrc/models/
*.ckpt
*.safetensors
*.bin
*.pth

# Ignore Outputs (We only want code in the repo, not test artifacts)
outputs/*
!outputs/.gitkeep
inputs/*
!inputs/.gitkeep

# Ignore IDE settings
.vscode/
.idea/