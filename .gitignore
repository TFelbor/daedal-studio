# Personal config — contains secrets and machine-specific paths
pythonsrc/config.py

# Pipeline outputs — not part of source
outputs/
inputs/

# ML model weights — too large for git
pythonsrc/models/
*.ckpt
*.safetensors
*.bin
*.pt
*.pth

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Conda / virtual environments
env/
venv/
conda-env/
*.conda

# Docker secrets — .env.template is safe to commit, .env is NOT
.env
# (but NOT .env.template — that is intentionally committed)

# Docker build cache and temp artifacts
.dockerignore.tmp

# macOS
.DS_Store
.AppleDouble

# Logs and reports
*.log
outputs/*.txt
outputs/*.md

# IDE
.vscode/
.idea/
*.swp