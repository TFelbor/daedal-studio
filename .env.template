# ────────────────────────────────────────────────────────────────────────────
# .env.template — Environment variable template for ds-mvp Docker setup.
#
# Setup:
#   cp .env.template .env
#   # Edit .env and fill in your actual values (especially OCTOPRINT_API_KEY).
#   # .env is gitignored and must NEVER be committed.
#
# Priority order:
#   1. Environment variables set directly on the host or in docker run -e
#   2. Values from this .env file (loaded by Docker Compose automatically)
#   3. Hardcoded fallbacks in config.template.py / config.py
# ────────────────────────────────────────────────────────────────────────────


# ── HuggingFace API Token ─────────────────────────────────────────────────────
# Required for FLUX and TRELLIS.2 model downloads from HuggingFace Hub.
# Get yours at https://huggingface.co/settings/tokens
# You must also accept the model license at:
#   https://huggingface.co/black-forest-labs/FLUX.2-klein-4B
HF_TOKEN=


# ── OctoPrint Connection ──────────────────────────────────────────────────────
# URL of your OctoPrint instance.
# macOS / Windows: use host.docker.internal to reach OctoPrint on the host.
# Linux (native Docker): use your host's LAN IP (e.g. http://192.168.1.50:5001)
#   or add --add-host=host.docker.internal:host-gateway to your docker run command.
OCTOPRINT_URL=http://host.docker.internal:5001

# OctoPrint Application API Key.
# Find this in OctoPrint → Settings → API → Global API Key.
# NEVER commit this value to git.
OCTOPRINT_API_KEY=


# ── CuraEngine ────────────────────────────────────────────────────────────────
# Path to the CuraEngine binary inside the container.
# Default: auto-detected (CuraEngine installed via apt in phase4/pipeline images).
# Override only if you have a custom binary location.
CURA_ENGINE_PATH=CuraEngine


# ── AI Model Paths ────────────────────────────────────────────────────────────
# These paths are INSIDE the container and map to named Docker volumes.
# Do not change these unless you also update the volume mounts in docker-compose.yml.

# FLUX.2-klein-4B weights (Phase 1 — Visualizer)
# The model is downloaded from HuggingFace on first run and cached here.
FLUX_MODEL_PATH=/models/flux

# TRELLIS.2-4B weights (Phase 2 — Sculptor)
# Downloaded from HuggingFace on first run and cached here. Only the GPU worker
# reads this: the CPU images never load the model.
TRELLIS2_MODEL_PATH=/models/trellis2


# ── Phase 2 Sculptor backend (TRELLIS.2) ──────────────────────────────────────
# TRELLIS.2-4B needs an NVIDIA GPU with ~24 GB of VRAM and four compiled CUDA
# extensions. There is no CPU fallback, so a machine without such a GPU reaches
# the model through the GPU worker (services/trellis2_worker/).
#
#   auto      remote if DS_SCULPTOR_REMOTE_URL is set, else trellis2 if a CUDA
#             GPU is visible, else pixazo if PIXAZO_API_KEY is set, else fail with
#             an actionable message. The paid endpoint is tried last on purpose:
#             hardware you already own is never passed over for one that bills.
#   trellis2  in-process; requires the GPU and TRELLIS2_REPO_PATH
#   remote    post the blueprint to a self-hosted GPU worker
#   pixazo    call Pixazo's hosted TRELLIS.2 endpoint (EUR 0,32 per generation).
#             The only backend that works on an Apple Silicon Mac.
DS_SCULPTOR_BACKEND=auto

# Worker root URL, e.g. http://gpu-host:8100. Required for the remote backend.
DS_SCULPTOR_REMOTE_URL=

# Shared secret, if the worker was started with DS_WORKER_API_KEY.
DS_SCULPTOR_REMOTE_KEY=

# Path to the TRELLIS.2 source checkout — only needed for the in-process backend,
# because the upstream repo is not pip-installable.
TRELLIS2_REPO_PATH=

# Voxel resolution: 512 | 1024 | 1024_cascade | 1536_cascade.
# Higher captures finer detail at more GPU time (512 ~3s, 1536 ~60s on an H100).
# The hosted endpoint has no cascade sampler, so both cascade values collapse onto
# their target resolution there — the job records both, so the two never look alike
# in the dataset.
TRELLIS2_PIPELINE_TYPE=1024_cascade

# Background-removal weights for Phase 2's image conditioning. Leave unset.
#
# The TRELLIS.2 checkpoint configures this step as briaai/RMBG-2.0, which is
# CC BY-NC 4.0 — non-commercial without a paid BRIA agreement — so the code
# substitutes MIT BiRefNet weights before the pipeline loads. Set this only to pin
# a revision (repo@sha) or to point at a mirror; a value from the deny-list in
# pythonsrc/sculptors/background.py is refused at startup, not silently accepted.
# DS_BIREFNET_MODEL_ID=ZhengPeng7/BiRefNet


# ── Phase 2 via Pixazo's hosted TRELLIS.2 (EUR 0,32 per generation) ───────────
# Subscription key for https://gateway.pixazo.ai. Setting this is what makes Phase 2
# work on a machine with no NVIDIA GPU.
PIXAZO_API_KEY=

# Refuse-to-spend switch for anything that bills per call. Leave blank (or 0/false/no)
# to allow paid generations; any other value makes the pixazo backend raise instead of
# spending money. The test suite sets this automatically; set it in CI and on shared
# machines that must never bill.
DS_DISABLE_PAID_BACKENDS=

# Override the gateway root. Leave blank for the public gateway.
DS_PIXAZO_GATEWAY=

# The API fetches the blueprint from a URL rather than accepting an upload. Leave
# blank to inline it as a data: URI (no infrastructure needed). Set it to a public
# base URL — an R2 bucket, a tunnel to the API server — to send a link instead.
DS_PIXAZO_IMAGE_BASE_URL=

# The endpoint returns GLB, which is Y-up by glTF convention, so the client rotates
# it to Z-up. Set this to `z` if a printed part comes out upright but the model
# looked wrong in the viewer, or vice versa. Blank means `y`.
DS_PIXAZO_UP_AXIS=


# ── PyTorch / MPS ─────────────────────────────────────────────────────────────
# Enable CPU fallback for MPS ops not yet supported on Apple Silicon.
# Set to "0" when running with a real NVIDIA GPU (via docker-compose.gpu.yml).
PYTORCH_ENABLE_MPS_FALLBACK=1


# ── HuggingFace Cache ─────────────────────────────────────────────────────────
# Directory for HuggingFace Hub downloads (tokenisers, configs, etc.)
# Mapped to the ds-models-hf-cache named volume.
HF_HOME=/models/hf_cache
TRANSFORMERS_CACHE=/models/hf_cache

# ── I/O Directories ───────────────────────────────────────────────────────────
# Runtime I/O directories (on the host). These are gitignored and only contain
# transient pipeline data (blueprint images, meshes, G-code).
# Defaults: data/inputs/ and data/outputs/ relative to the repo root.
# Override only if you need a custom location.
# DS_INPUTS_DIR=/app/inputs
# DS_OUTPUTS_DIR=/app/outputs

# ── Telemetry database (PostgreSQL on Supabase) ───────────────────────────────
# REQUIRED. There is one telemetry database and every process — the API server,
# the pipeline container, the native Mac pipeline, run_operator.py — reaches it
# through this one URL. Nothing falls back to a local file: an unset value is a
# startup error that names this variable.
#
# Supabase → Project Settings → Database → Connection string. Use the **session**
# pooler (port 5432, IPv4-friendly) or the direct connection; the transaction
# pooler (6543) works but is not the documented path. Append `?sslmode=require`
# to insist on TLS.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# A local PostgreSQL works too for development — from inside the pipeline
# container the api-server rewrites a loopback host to host.docker.internal.
DS_DATABASE_URL=

# Per-process connection pool size and how long a caller waits for a connection.
# The defaults suit a single developer; Supabase's connection limit is shared by
# every process talking to the project.
# DS_DATABASE_POOL_MAX=6
# DS_DATABASE_TIMEOUT_S=10

# Seconds between the server's database health checks (0 disables the loop). The
# verdict is what GET /health reports under `database`.
# DS_DB_HEALTH_INTERVAL_S=60

# Where the config store's Fernet key lives. Leave unset: the default,
# ~/.ds-mvp/.config_key, is what the containers reach through the ~/.ds-mvp mount.
# DS_CONFIG_KEY_PATH=

DS_API_URL=http://127.0.0.1:8000
PAUSE_ON_FAILURE=false


# ── Where the API server listens ──────────────────────────────────────────────
# The host address the API is published on — by `ports:` in
# infra/docker-compose.yml for a container run, and by uvicorn's --host for
# `make start-native`. The default is loopback, so the app is reachable at
# http://127.0.0.1:8000 on the machine running it and from nowhere else.
#
# There is no end-user authentication in this server, and POST /jobs spends
# EUR 0,32 per hosted generation, POST /jobs/{id}/print-dispatch heats a nozzle
# and PUT /config rewrites printer credentials. Set this to 0.0.0.0 only when the
# API is deliberately exposed and authenticated.
#
# This is the host side only. Inside the container uvicorn keeps --host 0.0.0.0:
# Docker publishes a port by connecting to the container's own address, so a
# loopback bind in there would make the published port dead.
DS_API_BIND=127.0.0.1

# Code-version stamp recorded on every job row (print_job.git_sha). Resolved from
# `git rev-parse` automatically when running from a checkout; set it explicitly
# only for a container image that carries no .git.
# DS_GIT_SHA=

