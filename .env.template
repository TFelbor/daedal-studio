# ────────────────────────────────────────────────────────────────────────────
# .env.template — Environment variable template for p2p-mesh Docker setup.
#
# Setup:
#   cp .env.template .env
#   # Edit .env and fill in your actual values (especially OCTOPRINT_API_KEY).
#   # .env is gitignored and must NEVER be committed.
#
# Priority order:
#   1. Environment variables set directly on the host or in docker run -e
#   2. Values from this .env file (loaded by Docker Compose automatically)
#   3. Hardcoded fallbacks in config.template.py / config.py
# ────────────────────────────────────────────────────────────────────────────


# ── HuggingFace API Token ─────────────────────────────────────────────────────
# Required for FLUX and TRELLIS.2 model downloads from HuggingFace Hub.
# Get yours at https://huggingface.co/settings/tokens
# You must also accept the model license at:
#   https://huggingface.co/black-forest-labs/FLUX.2-klein-4B
HF_TOKEN=


# ── OctoPrint Connection ──────────────────────────────────────────────────────
# URL of your OctoPrint instance.
# macOS / Windows: use host.docker.internal to reach OctoPrint on the host.
# Linux (native Docker): use your host's LAN IP (e.g. http://192.168.1.50:5001)
#   or add --add-host=host.docker.internal:host-gateway to your docker run command.
OCTOPRINT_URL=http://host.docker.internal:5001

# OctoPrint Application API Key.
# Find this in OctoPrint → Settings → API → Global API Key.
# NEVER commit this value to git.
OCTOPRINT_API_KEY=


# ── CuraEngine ────────────────────────────────────────────────────────────────
# Path to the CuraEngine binary inside the container.
# Default: auto-detected (CuraEngine installed via apt in phase4/pipeline images).
# Override only if you have a custom binary location.
CURA_ENGINE_PATH=CuraEngine


# ── AI Model Paths ────────────────────────────────────────────────────────────
# These paths are INSIDE the container and map to named Docker volumes.
# Do not change these unless you also update the volume mounts in docker-compose.yml.

# FLUX.2-klein-4B weights (Phase 1 — Visualizer)
# The model is downloaded from HuggingFace on first run and cached here.
FLUX_MODEL_PATH=/models/flux

# TRELLIS.2-4B weights (Phase 2 — Sculptor)
# Downloaded from HuggingFace on first run and cached here. Only the GPU worker
# reads this: the CPU images never load the model.
TRELLIS2_MODEL_PATH=/models/trellis2


# ── Phase 2 Sculptor backend (TRELLIS.2) ──────────────────────────────────────
# TRELLIS.2-4B needs an NVIDIA GPU with ~24 GB of VRAM and four compiled CUDA
# extensions. There is no CPU fallback, so a machine without such a GPU reaches
# the model through the GPU worker (services/trellis2_worker/).
#
#   auto      remote if P2P_SCULPTOR_REMOTE_URL is set, else trellis2 if a CUDA
#             GPU is visible, else fail with an actionable message
#   trellis2  in-process; requires the GPU and TRELLIS2_REPO_PATH
#   remote    post the blueprint to a GPU worker
P2P_SCULPTOR_BACKEND=auto

# Worker root URL, e.g. http://gpu-host:8100. Required for the remote backend.
P2P_SCULPTOR_REMOTE_URL=

# Shared secret, if the worker was started with P2P_WORKER_API_KEY.
P2P_SCULPTOR_REMOTE_KEY=

# Path to the TRELLIS.2 source checkout — only needed for the in-process backend,
# because the upstream repo is not pip-installable.
TRELLIS2_REPO_PATH=

# Voxel resolution: 512 | 1024 | 1024_cascade | 1536_cascade.
# Higher captures finer detail at more GPU time (512 ~3s, 1536 ~60s on an H100).
TRELLIS2_PIPELINE_TYPE=1024_cascade


# ── PyTorch / MPS ─────────────────────────────────────────────────────────────
# Enable CPU fallback for MPS ops not yet supported on Apple Silicon.
# Set to "0" when running with a real NVIDIA GPU (via docker-compose.gpu.yml).
PYTORCH_ENABLE_MPS_FALLBACK=1


# ── HuggingFace Cache ─────────────────────────────────────────────────────────
# Directory for HuggingFace Hub downloads (tokenisers, configs, etc.)
# Mapped to the p2p-models-hf-cache named volume.
HF_HOME=/models/hf_cache
TRANSFORMERS_CACHE=/models/hf_cache

# ── I/O Directories ───────────────────────────────────────────────────────────
# Runtime I/O directories (on the host). These are gitignored and only contain
# transient pipeline data (blueprint images, meshes, G-code).
# Defaults: data/inputs/ and data/outputs/ relative to the repo root.
# Override only if you need a custom location.
# P2P_INPUTS_DIR=/app/inputs
# P2P_OUTPUTS_DIR=/app/outputs

# ── Telemetry & Error Handling ────────────────────────────────────────────────
TELEMETRY_DB_PATH=/app/telemetry/telemetry.db
P2P_API_URL=http://127.0.0.1:8000
PAUSE_ON_FAILURE=false

